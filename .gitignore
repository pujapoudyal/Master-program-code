# ── Data files ───────────────────────────────────────────
# Keep the data/ folder structure but ignore large raw files
data/raw/
*.csv
*.hdf
*.h5
*.nc          # NetCDF
*.nc4
*.hdf5
*.parquet
*.feather

# Allow small sample/reference CSVs if explicitly tracked
!data/sample/*.csv

